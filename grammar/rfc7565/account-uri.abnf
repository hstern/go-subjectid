; RFC 7565 §7
; (parentheses added around the first-char alternation; the bare RFC
; form reads as `unreserved / (sub-delims 0*(...))` under ABNF operator
; precedence, which matches only one-char userparts — clearly not the
; RFC's intent.)
account-uri = "acct" ":" userpart "@" host
userpart    = ( unreserved / sub-delims )
              0*( unreserved / pct-encoded / sub-delims )

; RFC 3986 §3.2.2 (host) with RFC 6874 zone-id extension
host        = IP-literal / IPv4address / reg-name
IP-literal  = "[" ( IPv6addrz / IPv6address / IPvFuture ) "]"
IPv6addrz   = IPv6address "%25" ZoneID
ZoneID      = 1*( unreserved / pct-encoded )
IPvFuture   = ( "v" / "V" ) 1*hexdig-ci "." 1*( unreserved / sub-delims / ":" )
reg-name    = *( unreserved / pct-encoded / sub-delims )

; RFC 3986 §3.2.2 IPv4 / IPv6
IPv4address = dec-octet "." dec-octet "." dec-octet "." dec-octet
dec-octet   = "25" %x30-35        ; 250-255
            / "2" %x30-34 DIGIT   ; 200-249
            / "1" 2DIGIT          ; 100-199
            / %x31-39 DIGIT       ; 10-99
            / DIGIT               ; 0-9
IPv6address =                            6( h16 ":" ) ls32
            /                       "::" 5( h16 ":" ) ls32
            / [               h16 ] "::" 4( h16 ":" ) ls32
            / [ *1( h16 ":" ) h16 ] "::" 3( h16 ":" ) ls32
            / [ *2( h16 ":" ) h16 ] "::" 2( h16 ":" ) ls32
            / [ *3( h16 ":" ) h16 ] "::"    h16 ":"   ls32
            / [ *4( h16 ":" ) h16 ] "::"              ls32
            / [ *5( h16 ":" ) h16 ] "::"              h16
            / [ *6( h16 ":" ) h16 ] "::"
h16         = 1*4hexdig-ci
ls32        = ( h16 ":" h16 ) / IPv4address

; RFC 3986 §2.2–2.3 character sets
unreserved  = ALPHA / DIGIT / "-" / "." / "_" / "~"
pct-encoded = "%" hexdig-ci hexdig-ci
sub-delims  = "!" / "$" / "&" / "'" / "(" / ")"
            / "*" / "+" / "," / ";" / "="

; Case-insensitive hex digit (pap's built-in HEXDIG is uppercase-only
; per literal RFC 5234, but URI hex is case-insensitive per RFC 3986
; §6.2.2.1).
hexdig-ci   = DIGIT
            / "A" / "B" / "C" / "D" / "E" / "F"
            / "a" / "b" / "c" / "d" / "e" / "f"
